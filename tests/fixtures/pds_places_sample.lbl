PDS_VERSION_ID = PDS3
RECORD_TYPE = FIXED_LENGTH
RECORD_BYTES = 72
FILE_RECORDS = 5
^TABLE = "pds_places_sample.tab"

OBJECT = TABLE
  INTERCHANGE_FORMAT = ASCII
  ROWS = 5
  COLUMNS = 7
  ROW_BYTES = 72

  OBJECT = COLUMN
    NAME = "SOL"
    COLUMN_NUMBER = 1
    START_BYTE = 1
    BYTES = 6
    DATA_TYPE = ASCII_INTEGER
    DESCRIPTION = "Mission sol number"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "SITE"
    COLUMN_NUMBER = 2
    START_BYTE = 8
    BYTES = 5
    DATA_TYPE = ASCII_INTEGER
    DESCRIPTION = "Site index"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "DRIVE"
    COLUMN_NUMBER = 3
    START_BYTE = 14
    BYTES = 5
    DATA_TYPE = ASCII_INTEGER
    DESCRIPTION = "Drive index"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "LATITUDE"
    COLUMN_NUMBER = 4
    START_BYTE = 20
    BYTES = 12
    DATA_TYPE = ASCII_REAL
    UNIT = "DEGREE"
    DESCRIPTION = "Planetocentric latitude"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "LONGITUDE"
    COLUMN_NUMBER = 5
    START_BYTE = 33
    BYTES = 12
    DATA_TYPE = ASCII_REAL
    UNIT = "DEGREE"
    DESCRIPTION = "Aerocentric East longitude 0-360"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "ELEVATION"
    COLUMN_NUMBER = 6
    START_BYTE = 46
    BYTES = 12
    DATA_TYPE = ASCII_REAL
    UNIT = "METER"
    DESCRIPTION = "Elevation relative to MOLA areoid"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "ODOMETRY"
    COLUMN_NUMBER = 7
    START_BYTE = 59
    BYTES = 12
    DATA_TYPE = ASCII_REAL
    UNIT = "METER"
    DESCRIPTION = "Cumulative rover odometry in meters"
  END_OBJECT = COLUMN
END_OBJECT = TABLE
END
